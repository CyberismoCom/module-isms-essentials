% The buttons of all libraries of a home, on the home card, grouped by library. The parts of the
% libraries come from ismsa/calculations/extensions.

ismsa_ilPart(Library, Template, Label, Target) :-
    base_projectCardType({{cardKey}}, "ismsa/cardTypes/moduleHome"),
    ismsa_libraryPart({{cardKey}}, Library, Template, Label, Target).

ismsa_ilInstalled(Template) :-
    ismsa_libraryPartInstalled({{cardKey}}, Template).

result(result).

childResultCollection(result, "libraries").

childResult(result, Library, "libraries") :-
    ismsa_ilPart(Library, _, _, _).

resultField(Library, "name", Library, "shortText") :-
    ismsa_ilPart(Library, _, _, _).

resultField(Library, "rank", Rank, "integer") :-
    ismsa_ilPart(Library, _, _, _),
    ismsa_libraryRank(Library, Rank).

resultField(Library, "rank", 99, "integer") :-
    ismsa_ilPart(Library, _, _, _),
    not ismsa_libraryRank(Library, _).

childResult(Library, Template, "parts") :-
    ismsa_ilPart(Library, Template, _, _).

resultField(Template, "template", Template, "shortText") :-
    ismsa_ilPart(_, Template, _, _).

resultField(Template, "buttonLabel", Label, "shortText") :-
    ismsa_ilPart(_, Template, Label, _).

resultField(Template, "targetKey", Target, "shortText") :-
    ismsa_ilPart(_, Template, _, Target).

resultField(Template, "targetTitle", Title, "shortText") :-
    ismsa_ilPart(_, Template, _, Target),
    field(Target, "title", Title).

% The controls come first, then the registers on the home card, then the other parts.

resultField(Template, "kind", 1, "integer") :-
    ismsa_ilPart(_, Template, _, Target),
    field(Target, "base/fieldTypes/identifier", "ismsa_register_central-controls").

resultField(Template, "kind", 2, "integer") :-
    ismsa_ilPart(_, Template, _, {{cardKey}}).

resultField(Template, "kind", 3, "integer") :-
    ismsa_ilPart(_, Template, _, Target),
    Target != {{cardKey}},
    not field(Target, "base/fieldTypes/identifier", "ismsa_register_central-controls").

resultField(Template, "installed", "yes", "shortText") :-
    ismsa_ilPart(_, Template, _, _),
    ismsa_ilInstalled(Template).

order(2, "libraries", 1, "rank", "ASC").
order(2, "libraries", 2, "name", "ASC").
order(3, "parts", 1, "kind", "ASC").
order(3, "parts", 2, "buttonLabel", "ASC").
