% The libraries of a home, on the home card. The rules are in ismsa/calculations/libraryChoice
% (which libraries the answers require, and why the others are not needed) and in
% ismsa/calculations/extensions (the parts of the libraries).
%
% Each collection key is tagged, so that the keys of different collections never collide.

ismsa_ilHome({{cardKey}}) :-
    base_projectCardType({{cardKey}}, "ismsa/cardTypes/moduleHome").

result(result).

childResultCollection(result, "required").
childResultCollection(result, "notNeeded").
childResultCollection(result, "undecided").
childResultCollection(result, "others").

% Libraries that the home needs

childResult(result, ("required", Library), "required") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequired(Home, Library).

resultField(("required", Library), "title", Title, "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequired(Home, Library),
    ismsa_choiceLibrary(Library, Title).

resultField(("required", Library), "rank", Rank, "integer") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequired(Home, Library),
    ismsa_libraryRank(Library, Rank).

resultField(("required", Library), "added", "yes", "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequired(Home, Library),
    ismsa_libraryAdded(Home, Library).

childResult(("required", Library), ("reason", Library, Reason), "reasons") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequirement(Home, Library, Reason).

resultField(("reason", Library, Reason), "text", Reason, "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequirement(Home, Library, Reason).

% The parts that are still missing, with their buttons

ismsa_ilMissingPart(Library, Template, Label, Target) :-
    ismsa_ilHome(Home),
    ismsa_libraryPart(Home, Library, Template, Label, Target),
    not ismsa_libraryPartInstalled(Home, Template).

ismsa_ilShownLibrary(("required", Library), Library) :-
    ismsa_ilHome(Home),
    ismsa_libraryRequired(Home, Library).

ismsa_ilShownLibrary(("other", Library), Library) :-
    ismsa_ilHome(Home),
    ismsa_libraryInHome(Home, Library),
    not ismsa_choiceLibrary(Library, _).

% Only the next missing part of each library has a button (E10 P3), so that the user sees one
% click at a time. The controls come first, then the registers, the requirements, and the other
% parts (ismsa_ilKind/3 below). Some parts can be added only after an earlier part, because their
% target is a register of the earlier part. "Part 2 of 3" tells how many clicks are left.

ismsa_ilNextKind(Library, Kind) :-
    ismsa_ilMissingPart(Library, _, _, _),
    Kind = #min { K : ismsa_ilMissingPart(Library, T, _, _), ismsa_ilKind(T, K, _) }.

ismsa_ilNextLabel(Library, Label) :-
    ismsa_ilNextKind(Library, Kind),
    Label = #min { L : ismsa_ilMissingPart(Library, T, L, _), ismsa_ilKind(T, Kind, _) }.

ismsa_ilNextPart(Library, Template) :-
    ismsa_ilNextLabel(Library, Label),
    ismsa_ilNextKind(Library, Kind),
    ismsa_ilMissingPart(Library, Template, Label, _),
    ismsa_ilKind(Template, Kind, _).

childResult(Node, ("part", Template), "parts") :-
    ismsa_ilShownLibrary(Node, Library),
    ismsa_ilNextPart(Library, Template).

% The number of the next part, and the number of parts of the library in this home

ismsa_ilPartCount(Library, N) :-
    ismsa_ilShownLibrary(_, Library),
    ismsa_ilHome(Home),
    N = #count { T : ismsa_installableExtension(_, Library, T, _, _), ismsa_libraryOfferedInHome(T, Home) }.

ismsa_ilPartsInstalled(Library, N) :-
    ismsa_ilShownLibrary(_, Library),
    ismsa_ilHome(Home),
    N = #count { T : ismsa_installableExtension(_, Library, T, _, _), ismsa_libraryPartInstalled(Home, T) }.

resultField(Node, "partNumber", Installed + 1, "integer") :-
    ismsa_ilShownLibrary(Node, Library),
    ismsa_ilPartsInstalled(Library, Installed),
    ismsa_ilPartCount(Library, Count),
    Count > 1.

resultField(Node, "partCount", Count, "integer") :-
    ismsa_ilShownLibrary(Node, Library),
    ismsa_ilPartCount(Library, Count),
    Count > 1.

resultField(("part", Template), "template", Template, "shortText") :-
    ismsa_ilMissingPart(_, Template, _, _).

resultField(("part", Template), "buttonLabel", Label, "shortText") :-
    ismsa_ilMissingPart(_, Template, Label, _).

resultField(("part", Template), "targetKey", Target, "shortText") :-
    ismsa_ilMissingPart(_, Template, _, Target).

resultField(("part", Template), "targetTitle", Title, "shortText") :-
    ismsa_ilMissingPart(_, Template, _, Target),
    field(Target, "title", Title).

% The controls come first, then the registers on the home card, then the other parts.

ismsa_ilKind(Template, 1, "The controls go to") :-
    ismsa_ilMissingPart(_, Template, _, Target),
    field(Target, "base/fieldTypes/identifier", "ismsa_register_central-controls").

ismsa_ilKind(Template, 2, "The registers go to") :-
    ismsa_ilMissingPart(_, Template, _, {{cardKey}}).

ismsa_ilKind(Template, 3, "The requirements go to") :-
    ismsa_ilMissingPart(_, Template, _, Target),
    field(Target, "base/fieldTypes/identifier", "ismsa_register_compliance").

ismsa_ilKind(Template, 4, "The content goes to") :-
    ismsa_ilMissingPart(_, Template, _, Target),
    Target != {{cardKey}},
    not field(Target, "base/fieldTypes/identifier", "ismsa_register_central-controls"),
    not field(Target, "base/fieldTypes/identifier", "ismsa_register_compliance").

resultField(("part", Template), "kind", Kind, "integer") :-
    ismsa_ilKind(Template, Kind, _).

resultField(("part", Template), "kindText", Text, "shortText") :-
    ismsa_ilKind(Template, _, Text).

% Libraries that the home does not need, and libraries that the answers do not decide yet

childResult(result, ("not", Library), "notNeeded") :-
    ismsa_ilHome(Home),
    ismsa_libraryNotNeeded(Home, Library, _).

resultField(("not", Library), "title", Title, "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryNotNeeded(Home, Library, _),
    ismsa_choiceLibrary(Library, Title).

resultField(("not", Library), "reason", Reason, "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryNotNeeded(Home, Library, Reason).

resultField(("not", Library), "rank", Rank, "integer") :-
    ismsa_ilHome(Home),
    ismsa_libraryNotNeeded(Home, Library, _),
    ismsa_libraryRank(Library, Rank).

resultField(("not", Library), "inHome", "yes", "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryNotNeeded(Home, Library, _),
    ismsa_libraryPartInstalled(Home, Template),
    ismsa_libraryPart(Home, Library, Template, _, _).

childResult(result, ("undecided", Library), "undecided") :-
    ismsa_ilHome(Home),
    ismsa_libraryUndecided(Home, Library).

resultField(("undecided", Library), "title", Title, "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryUndecided(Home, Library),
    ismsa_choiceLibrary(Library, Title).

resultField(("undecided", Library), "rank", Rank, "integer") :-
    ismsa_ilHome(Home),
    ismsa_libraryUndecided(Home, Library),
    ismsa_libraryRank(Library, Rank).

% Libraries of other modules, which the questions do not cover

childResult(result, ("other", Library), "others") :-
    ismsa_ilShownLibrary(("other", Library), Library).

resultField(("other", Library), "title", Library, "shortText") :-
    ismsa_ilShownLibrary(("other", Library), Library).

resultField(("other", Library), "added", "yes", "shortText") :-
    ismsa_ilShownLibrary(("other", Library), Library),
    ismsa_ilHome(Home),
    ismsa_libraryAdded(Home, Library).

resultField(result, "anyRequired", "yes", "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryRequired(Home, _).

resultField(result, "anyNotNeeded", "yes", "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryNotNeeded(Home, _, _).

resultField(result, "anyUndecided", "yes", "shortText") :-
    ismsa_ilHome(Home),
    ismsa_libraryUndecided(Home, _).

resultField(result, "anyOthers", "yes", "shortText") :-
    ismsa_ilShownLibrary(("other", _), _).

order(2, "required", 1, "rank", "ASC").
order(2, "notNeeded", 1, "rank", "ASC").
order(2, "undecided", 1, "rank", "ASC").
order(2, "others", 1, "title", "ASC").
